{
  "server": {
    "name": "HomeMCP-HUB",
    "transport": "stdio"
  },
  "plugins": {
    "clock": {
      "enabled": true,
      "config": {
        "timezone": "UTC"
      }
    },
    "memory": {
      "enabled": true,
      "config": {
        "notes": [
          {
            "id": "welcome",
            "title": "Welcome to HomeMCP-HUB",
            "body": "Plugins own their MCP surface; HomeMCP-HUB aggregates it."
          }
        ]
      }
    }
  },
  "policy": {
    "tools": {
      "memory.add_note": true,
      "memory.search_notes": true
    },
    "resources": {},
    "prompts": {}
  }
}
